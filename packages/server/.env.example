# cortexmd server configuration example.
# Copy to .env and adjust. Only API_KEY is strictly required.

# --- Required ---

# Bearer token clients must present (Authorization: Bearer <API_KEY>).
API_KEY=change-me

# --- Vaults ---

# The brain vault: the ONLY directory the server ever writes to.
# Defaults to a per-user data dir if unset:
#   Linux/macOS: $XDG_DATA_HOME/cortexmd/brain (or ~/.local/share/cortexmd/brain)
#   Windows:     %LOCALAPPDATA%\cortexmd\brain
# Created automatically on first boot.
BRAIN_VAULT=

# Read-only source vaults, comma-separated. Each entry is `name=path` (the name
# is a label) or a bare `path` (basename is used as the name). Defaults to empty.
#   Example: SOURCE_VAULTS=perso=/data/perso,work=/data/work-kb
SOURCE_VAULTS=

# --- Server ---

# HTTP listen port (default 3000).
API_PORT=3000

# Externally reachable base URL, used for OAuth metadata and links.
PUBLIC_URL=http://localhost:3000

# --- Features ---

# Embeddings / semantic search. Set to "false" to disable (default enabled).
ENABLE_EMBEDDINGS=true

# Reranker for search results. Set to "true" to enable (default disabled).
ENABLE_RERANKER=false

# Memory "dream" consolidation schedule (cron expression). Empty to disable.
DREAM_SCHEDULE=

# Dream vault hygiene (runs inside every dream: memory_dream, POST /dream,
# scheduled and idle-edge runs; honors dryRun; serialized by an operation lock).
# Orphan triage — notes with zero inbound links, older than the min age, outside
# protected paths (Indexes/, Templates/, any templates folder, Perso/templates/,
# Projects/, Ops/Agent Diaries/, Archive/, Journal/, Code/, "* Index" notes):
#   EMPTY (frontmatter/headings/template boilerplate only, no record data, not a
#   person/org/project/entity/task) -> deleted (links rewritten, journaled);
#   NOISE (capture-filter title, low importance, little prose) -> archived;
#   VALUABLE -> linked from its Projects/ hub (frontmatter project, tag, link,
#   title mention) or a monthly Indexes/Memories/<Category>/ index.
# DREAM_ORPHAN_TRIAGE=true            # master switch
# DREAM_TRIAGE_DELETE_EMPTY=true
# DREAM_TRIAGE_ARCHIVE_NOISE=true
# DREAM_TRIAGE_LINK=true
# DREAM_TRIAGE_MIN_AGE_DAYS=7
# DREAM_TRIAGE_MAX_DELETE=25          # per-run caps
# DREAM_TRIAGE_MAX_ARCHIVE=50
# DREAM_TRIAGE_MAX_LINK=50
# DREAM_TRIAGE_MAX_SCAN=2000          # orphans examined per run
# DREAM_TRIAGE_NOISE_MAX_WORDS=80     # noise-titled notes with more prose are kept
# DREAM_TRIAGE_PROTECTED_PREFIXES=    # extra comma-separated path prefixes to never touch
# Project reconstruction — rebuilds the managed "## Related memories" block of
# each Projects/<slug>.md (user text outside it is preserved), grouped by type,
# deduped, dangling links dropped; overflow goes to Indexes/Projects/<slug>/<YYYY-MM>.md.
# Folded "## Consolidated memories" blocks beyond the fold cap move to
# Projects/Archive/<slug>-folded-<date>.md.
# DREAM_PROJECT_REBUILD=true
# DREAM_PROJECT_MAX_LINKS=50          # memories listed inline per hub
# DREAM_PROJECT_MAX_REBUILDS=20       # hubs rewritten per run
# DREAM_PROJECT_FOLD_CAP=20           # folded bodies kept inline per hub

# --- Deprecated (still honored for one release, with a warning) ---
# Prefer the new names above. These map onto BRAIN_VAULT / SOURCE_VAULTS.
#
# VAULT_RW=          # deprecated -> BRAIN_VAULT
# VAULT_RO_PERSO=    # deprecated -> SOURCE_VAULTS (append as a path)
# VAULT_RO_HAPLY=    # deprecated -> SOURCE_VAULTS (append as a path)
