{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortexmd",
            "args": ["hud-line", "--ensure-daemon"],
            "timeout": 8,
            "statusMessage": "cortexmd: HUD daemon"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/code_nav_hint_hook.mjs"],
            "timeout": 6,
            "statusMessage": "cortexmd: code-nav"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/wakeup_directive_hook.mjs"],
            "timeout": 6,
            "statusMessage": "cortexmd: wakeup"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/userprompt_hook.mjs"],
            "timeout": 8,
            "statusMessage": "cortexmd: recall"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cortexmd",
            "args": ["rewrite", "--hook"],
            "timeout": 6
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/code_nav_pretool_hook.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/posttooluse_hook.mjs"],
            "timeout": 6,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/diary_stop_hook.mjs"],
            "timeout": 8
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/precompact_diary_hook.mjs"],
            "timeout": 8
          }
        ]
      }
    ]
  }
}
