# cortexmd server configuration example.
# Copy to .env and adjust. Only API_KEY is strictly required.

# --- Required ---

# Bearer token clients must present (Authorization: Bearer <API_KEY>).
API_KEY=change-me

# --- Vaults ---

# The brain vault: the ONLY directory the server ever writes to.
# Defaults to a per-user data dir if unset:
#   Linux/macOS: $XDG_DATA_HOME/cortexmd/brain (or ~/.local/share/cortexmd/brain)
#   Windows:     %LOCALAPPDATA%\cortexmd\brain
# Created automatically on first boot.
BRAIN_VAULT=

# Read-only source vaults, comma-separated. Each entry is `name=path` (the name
# is a label) or a bare `path` (basename is used as the name). Defaults to empty.
#   Example: SOURCE_VAULTS=perso=/data/perso,work=/data/work-kb
SOURCE_VAULTS=

# --- Server ---

# HTTP listen port (default 3000).
API_PORT=3000

# Externally reachable base URL, used for OAuth metadata and links.
PUBLIC_URL=http://localhost:3000

# --- Features ---

# Embeddings / semantic search. Set to "false" to disable (default enabled).
ENABLE_EMBEDDINGS=true

# Embedding model (transformers.js / ONNX, CPU). Default: Xenova/all-MiniLM-L6-v2.
# Multilingual opt-ins with built-in presets (dimension, pooling, prefixes):
#   Xenova/multilingual-e5-small, Xenova/paraphrase-multilingual-MiniLM-L12-v2,
#   onnx-community/embeddinggemma-300m-ONNX, onnx-community/Qwen3-Embedding-0.6B-ONNX
# Each model + dimension has its own index file: switching re-embeds the vault
# in the background, switching back is instant.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# For a model without a preset:
# EMBEDDING_DIMENSION=384
# EMBEDDING_POOLING=mean            # mean | cls | last_token | sentence_embedding
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOC_PREFIX=

# Chunk-level vectors for long notes (default on; "off" = one vector per note).
# EMBEDDING_CHUNKING=on
# EMBEDDING_MAX_CHUNKS=24

# Local cross-encoder reranker module (default disabled; lazy-loaded).
# EXPERIMENTAL: the module is not wired into memory_recall / search (it cost
# ~1.2 s p50 and lowered top-1 on the real-vault eval); setting this has no
# effect on recall today.
# ENABLE_CROSS_ENCODER=false
# CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Reranker for search results. Set to "true" to enable (default disabled).
ENABLE_RERANKER=false

# Memory "dream" consolidation schedule (cron expression). Empty to disable.
DREAM_SCHEDULE=

# --- MCP tool surface ---

# Tools advertised in tools/list: standard (default) | chatgpt | tiny | nav |
# core | lean | full. Hidden tools stay reachable via tool_search + tool_invoke.
TOOL_PROFILE=standard

# Also register/advertise the ChatGPT connector `search`/`fetch` pair under any
# profile (always on under TOOL_PROFILE=chatgpt).
CHATGPT_SEARCH_FETCH=false

# --- Capture ---

# `|||`-separated, case-insensitive regexes on a capture's `source` marking it as
# machine exhaust (stored cold). Empty = built-in defaults; setting it REPLACES them.
MACHINE_CAPTURE_SOURCES=

# Days within which a recurring machine capture supersedes the previous one (0 = off).
RECURRING_CAPTURE_WINDOW_DAYS=7

# Async LLM reconcile on write (off by default; needs ANTHROPIC_API_KEY). When
# the contradiction / title-conflict heuristics flag a pair, a background worker
# asks a small Claude model for ADD | UPDATE | SUPERSEDE | DUPLICATE | NOOP and
# links the notes via frontmatter (never edits bodies or deletes). Dry-run (audit
# only, <DATA_DIR>/reconcile-audit.jsonl) stays on until RECONCILE_DRY_RUN=false.
RECONCILE_LLM=false
RECONCILE_DRY_RUN=true
RECONCILE_MODEL=claude-haiku-5-5
RECONCILE_MIN_CONFIDENCE=0.8
RECONCILE_MAX_QUEUE=100
RECONCILE_RATE_PER_MIN=10
RECONCILE_DAILY_BUDGET=200
RECONCILE_MAX_RETRIES=3
RECONCILE_TIMEOUT_MS=20000

# Automatic linking on store. AUTO_LINK=false disables all of it.
AUTO_LINK=true
# Entity auto-link confidence gate.
AUTO_LINK_MIN_CONFIDENCE=0.7
# Similarity backlinks into a `## Related (auto)` section (false = off).
AUTO_LINK_RELATED=true
# Fused-score floor for a similarity backlink.
AUTO_LINK_RELATED_MIN_SCORE=0.03
# Max similarity backlinks per note (hard cap 5).
AUTO_LINK_RELATED_MAX=2
# Inline knowledge-graph triple seeding, and the categories allowed to seed.
AUTO_SEED_KG=true
AUTO_SEED_KG_CATEGORIES=decision,fact,insight,preference,plan

# --- Operations ---

# Scheduled brain-vault backup: off (default) | on (daily 03:30) | "M H * * *".
BACKUP_SCHEDULE=off
# Archive directory (default <DATA_DIR>/backups).
BACKUP_DIR=
# Number of newest archives to keep.
BACKUP_KEEP=7

# Heap usage (% of the V8 heap limit) above which /health flags heap.warn and a
# warning is logged.
HEAP_WARN_PCT=80

# Boot index build: files read in parallel, and how long a tool call waits for
# the index before failing with an "indexing" error.
INDEX_READ_CONCURRENCY=16
INDEX_READY_WAIT_MS=20000

# Embedding sync batch size / pause between batches, and HNSW compaction
# thresholds (dead-slot ratio + minimum dead slots).
EMBED_SYNC_BATCH=32
EMBED_SYNC_PAUSE_MS=250
HNSW_COMPACT_RATIO=0.25
HNSW_COMPACT_MIN_DELETED=256

# Lexical index backend. Only `minisearch` (in RAM) is active today. `sqlite`
# (on-disk FTS5) and `shadow` are RESERVED for the rollout described in
# docs/ARCHITECTURE.md §6: setting them logs a warning at boot and the server
# keeps using MiniSearch.
SEARCH_BACKEND=minisearch
# SQLite lexical DB (derived cache, safe to delete). Must be on a LOCAL disk:
# WAL mode does not work on NFS/SMB volumes. Default <DATA_DIR>/lexical.sqlite.
LEXICAL_DB_PATH=
# Max event-loop block per sync slice (ms) and body KiB indexed per note.
LEXICAL_SYNC_SLICE_MS=25
LEXICAL_MAX_INDEXED_KB=256

# Recall ranking knobs (HYBRID_FUSION, RECALL_SCORING, RECALL_MIN_EVIDENCE, …)
# are documented with their defaults in src/config.ts; leave unset normally.

# --- Evaluation (dev only) ---

# Make recall read-only (no access bumps / co-recall writes). Leave unset in
# production; the eval harness sets it.
RECALL_NO_TOUCH=
# Directory the dashboard Lab tab reads recall-eval run JSON from
# (default: the harness results directory).
RECALL_EVAL_RESULTS_DIR=

# Optional read-only model workers (see docs/workers.md). Disabled by default.
# Exact tool-calling chat-completions endpoint; separate from the reranker.
WORKER_ENABLED=false
WORKER_PROVIDER=openai-compatible
WORKER_ENDPOINT=
WORKER_MODEL=
WORKER_API_KEY=
WORKER_MAX_CONCURRENCY=2
WORKER_MAX_TOOL_CALLS=12
WORKER_MAX_ROUNDS=8
WORKER_MAX_INPUT_TOKENS=100000
WORKER_MAX_OUTPUT_TOKENS=4000
WORKER_MAX_TOOL_RESULT_BYTES=16000
WORKER_TIMEOUT_MS=90000

# --- Deprecated (still honored for one release, with a warning) ---
# Prefer the new names above. These map onto BRAIN_VAULT / SOURCE_VAULTS.
#
# VAULT_RW=          # deprecated -> BRAIN_VAULT
# VAULT_RO_PERSO=    # deprecated -> SOURCE_VAULTS (append as a path)
# VAULT_RO_HAPLY=    # deprecated -> SOURCE_VAULTS (append as a path)
